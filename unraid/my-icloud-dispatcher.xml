<?xml version="1.0"?>
<Container version="2">
  <Name>icloud-dispatcher</Name>
  <Repository>ghcr.io/sidimam/icloud-dispatcher:latest</Repository>
  <Registry>https://github.com/sidimam/icloud-dispatcher/pkgs/container/icloud-dispatcher</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/sidimam/icloud-dispatcher</Support>
  <Project>https://github.com/sidimam/icloud-dispatcher</Project>
  <Overview>Un solo bot Telegram per il rinnovo 2FA Apple dei container iCloud (foto: boredazfcuk/icloudpd; iCloud Drive: mandarons/icloud-drive): legge "#nome auth" e "#nome 123456" dalla chat di casa e li consegna al container giusto. GUI web per utenti, impostazioni e nuovi container.</Overview>
  <Category>Tools: Backup:</Category>
  <WebUI>http://[IP]:[PORT:8787]/</WebUI>
  <TemplateURL/>
  <Icon>https://cdn-icons-png.magnific.com/512/7990/7990923.png</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs></PostArgs>
  <CPUset/>
  <DateInstalled></DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="TZ" Target="TZ" Default="Europe/Rome" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Rome</Config>
  <Config Name="Token del bot Telegram" Target="TELEGRAM_TOKEN" Default="" Mode="" Description="lo stesso bot di casa; il dispatcher e' l'unico a fare polling" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Chat ammesse" Target="ALLOWED_CHATS" Default="" Mode="" Description="chat id separate da virgola: privata dell'amministratore e gruppo famiglia" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="GUI" Target="8787" Default="8787" Mode="tcp" Description="interfaccia web (solo LAN: nessuna autenticazione)" Type="Port" Display="always" Required="true" Mask="false">8787</Config>
  <Config Name="Template Unraid" Target="/templates" Default="/boot/config/plugins/dockerMan/templates-user" Mode="rw" Description="template dei container (per creare/modificare utenti)" Type="Path" Display="advanced" Required="true" Mask="false">/boot/config/plugins/dockerMan/templates-user</Config>
  <Config Name="appdata" Target="/appdata" Default="/mnt/user/appdata" Mode="rw" Description="config dei container iCloud" Type="Path" Display="advanced" Required="true" Mask="false">/mnt/user/appdata</Config>
  <Config Name="photos" Target="/photos" Default="/mnt/user/media/photos" Mode="rw" Description="cartelle foto (nuovi utenti icloudpd)" Type="Path" Display="advanced" Required="true" Mask="false">/mnt/user/media/photos</Config>
  <Config Name="documents" Target="/documents" Default="/mnt/user/documents" Mode="rw" Description="destinazioni iCloud Drive (nuovi utenti iclouddrive)" Type="Path" Display="advanced" Required="true" Mask="false">/mnt/user/documents</Config>
  <Config Name="Socket Docker" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="rw" Description="per docker exec nei container iCloud" Type="Path" Display="always" Required="true" Mask="false">/var/run/docker.sock</Config>
  <Config Name="App (config.json + stato)" Target="/app" Default="/mnt/user/appdata/icloud-dispatcher" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/icloud-dispatcher</Config>
</Container>
